# Discord Bot Credentials (Required)
DISCORD_BOT_TOKEN=

# Logging Configuration (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# External Executables Path
FFMPEG_PATH=ffmpeg
YTDLP_PATH=yt-dlp

# Optional Custom Emojis (e.g. <:spotify:123456789012345678>)
EMOJI_SPOTIFY=
EMOJI_YOUTUBE=
EMOJI_SOUNDCLOUD=

# Language (en = English, id = Indonesian)
BOT_LANG=en

# Now Playing card behavior on track change
# old = keep history in channel, each track posts a new card (default, our behavior)
# new = delete the old card before sending a new one, clean channel (upstream behavior)
NOW_PLAYING_BEHAVIOR=old
