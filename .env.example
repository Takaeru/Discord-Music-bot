# ─ Discord Bot Credentials (Required) ───────────────────────────────────
# Create a bot at https://discord.com/developers/applications
# Enable: Message Content Intent, Server Members Intent, Voice States
DISCORD_BOT_TOKEN=

# ─ Logging ──────────────────────────────────────────────────────────────
# Levels: ERROR (only errors), WARN, INFO (default), DEBUG (verbose),
#         TRACE (extremely verbose, for development)
LOG_LEVEL=INFO

# ─ External Executables (Custom Paths) ──────────────────────────────────
# Path to ffmpeg/yt-dlp. Defaults to system PATH if left empty.
# Common: ffmpeg, yt-dlp (or full paths like /usr/bin/ffmpeg)
FFMPEG_PATH=ffmpeg
YTDLP_PATH=yt-dlp

# ─ Custom Emojis ────────────────────────────────────────────────────────
# Optional: Use custom server emojis for platform indicators in embeds
# Format: <:name:id> — e.g. <:spotify:123456789012345678>
EMOJI_SPOTIFY=
EMOJI_YOUTUBE=
EMOJI_SOUNDCLOUD=

# ─ Language ─────────────────────────────────────────────────────────────
# Select interface language. All user-facing strings (embeds, buttons,
# error messages, descriptions) are translated.
#   en = English (default)
#   id = Indonesian (Bahasa Indonesia)
BOT_LANG=en

# ─ Now Playing Card Behavior ────────────────────────────────────────────
# Controls how the Now Playing embed updates when the queue advances to
# the next track. Pick whichever feels cleaner for your server.
#
#   old = Keep history (default). Each track posts a brand new card in
#         the channel. Previous cards stay visible — you can scroll up
#         to see what was played. When the queue finishes, a separate
#         "done" message is posted.
#         Example channel timeline:
#           [Now Playing: Track 1] -> [Now Playing: Track 2] -> [Done]
#
#   new = Clean channel. The previous card is deleted before the new
#         one is posted, so only one card is visible at any time. When
#         the queue finishes, the last card is edited in-place to show
#         "Queue finished" — no extra message.
#         Example channel timeline:
#           [Now Playing: Track 1] -> [Now Playing: Track 2] -> (edited: Done)
#
# Unset or empty defaults to "old".
NOW_PLAYING_BEHAVIOR=old
# NOW_PLAYING_BEHAVIOR=new