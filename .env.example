# ─ Discord Bot Credentials (Required) ───────────────────────────────────
# Create a bot at https://discord.com/developers/applications
# Enable: Message Content Intent, Server Members Intent, Voice States
DISCORD_BOT_TOKEN=

# ─ Logging ──────────────────────────────────────────────────────────────
# Levels: ERROR (only errors), WARN, INFO (default), DEBUG (verbose),
#         TRACE (extremely verbose, for development)
LOG_LEVEL=INFO

# ─ External Executables (Custom Paths) ──────────────────────────────────
# Path to ffmpeg/yt-dlp. Defaults to system PATH if left empty.
# Common: ffmpeg, yt-dlp (or full paths like /usr/bin/ffmpeg)
FFMPEG_PATH=ffmpeg
YTDLP_PATH=yt-dlp

# ─ Custom Emojis ────────────────────────────────────────────────────────
# Optional: Use custom server emojis for platform indicators in embeds
# Format: <:name:id> — e.g. <:spotify:123456789012345678>
EMOJI_SPOTIFY=
EMOJI_YOUTUBE=
EMOJI_SOUNDCLOUD=

# ─ Language ─────────────────────────────────────────────────────────────
# Select interface language. All user-facing strings (embeds, buttons,
# error messages, descriptions) are translated.
#   en = English (default)
#   id = Indonesian (Bahasa Indonesia)
BOT_LANG=en

# ─ Now Playing Card Behavior ────────────────────────────────────────────
# Controls how the Now Playing embed updates when the queue advances to
# the next track. Pick whichever feels cleaner for your server.
#
#   old = Keep history (default). Each track posts a brand new card in
#         the channel. Previous cards stay visible — you can scroll up
#         to see what was played. When the queue finishes, a separate
#         "done" message is posted.
#         Example channel timeline:
#           [Now Playing: Track 1] -> [Now Playing: Track 2] -> [Done]
#
#   new = Clean channel. The previous card is deleted before the new
#         one is posted, so only one card is visible at any time. When
#         the queue finishes, the last card is edited in-place to show
#         "Queue finished" — no extra message.
#         Example channel timeline:
#           [Now Playing: Track 1] -> [Now Playing: Track 2] -> (edited: Done)
#
# Default: new (clean channel). Change to "old" to keep track history cards.
NOW_PLAYING_BEHAVIOR=new

# ─ Playlist & Radio/Mix Cap ─────────────────────────────────────────────
# Maximum number of tracks to load from YouTube playlists, mixes (list=RD),
# YouTube Radio, or Spotify playlists/albums.
# Setting a limit speeds up loading and prevents queue flooding.
# Default is 50. Set to 0 for unlimited.
MAX_PLAYLIST_ITEMS=50

# ─ MongoDB Database (Personal Playlist Storage) ─────────────────────────
# OPTIONAL — Leave ALL MongoDB fields blank to use the default local file storage
# (data/playlists.json). This works out-of-the-box for new users with zero setup.
#
# Fill these only if you want cloud-synced playlists across multiple bot instances.
# Recommended: MongoDB Atlas free tier (https://www.mongodb.com/cloud/atlas).
#
# Required fields if using MongoDB:
#   MONGO_USER         — your Atlas database user
#   MONGO_PASSWORD     — your Atlas database password
#   MONGO_HOST         — your cluster host (e.g. cluster0.abc123.mongodb.net)
#   MONGO_APP_NAME     — your Atlas app name (default: Cluster0)
#   MONGO_DATABASE     — database name to use
#
# Alternative: provide a full connection URI instead of the fields above.
# When MONGODB_URI is set, it overrides all individual MONGO_* fields.
MONGO_USER=
MONGO_PASSWORD=
MONGO_HOST=
MONGO_APP_NAME=Cluster0
MONGO_DATABASE=discord_music_bot

# Full connection URI (overrides MONGO_* if set):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/?appName=APP_NAME

# ─ Universal Multi-Provider AI DJ (Gemini, Claude, Grok, Qwen, Ollama, etc.) ──
# OPTIONAL — Leave LLM_API_KEY blank to use the built-in local heuristic taste profiler.
# This works out-of-the-box for new users with zero setup. AI features will still run,
# just with a simpler rule-based recommender instead of an LLM.
#
# AI-powered features (when LLM_API_KEY is set):
#   - Natural language mood search: /recommend mood:chill rainy night
#   - Live charismatic DJ commentary between tracks
#   - Song trivia and music taste analysis
#
# Supported providers:
#   - gemini  (default, free tier at https://aistudio.google.com)
#   - claude  (Anthropic Messages API)
#   - openai  (Official OpenAI API)
#   - openai_compatible  (for Grok, Qwen, Groq, DeepSeek, Ollama, OpenRouter, etc.)
#
# Required fields if using any provider:
#   LLM_PROVIDER  — one of: gemini | claude | openai | openai_compatible
#   LLM_API_KEY   — your provider's API key
#   LLM_MODEL     — model name (e.g. gemini-1.5-flash, claude-3-5-sonnet, gpt-4o)
#
# For openai_compatible: also set LLM_BASE_URL to your provider's endpoint.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Enable real-time Web Search Grounding (Google Search for Gemini, DuckDuckGo for Claude/OpenAI/Qwen/etc.)
# Default: true. Set to false to disable web grounding.
LLM_WEB_SEARCH=true

# Optional: Custom endpoint URL (e.g. for Ollama, OpenRouter, Groq, xAI)
# Required for openai_compatible provider.
# LLM_BASE_URL=https://api.groq.com/openai/v1

# ─ LLM API Key — Provider-Specific Alternatives (Optional) ─────────────
# The bot reads LLM_API_KEY above as the primary credential. If you prefer to keep
# provider keys separated (e.g. for secrets management), the bot will also check these
# provider-specific variables as fallbacks. Same logic, just more granular:
#
# GEMINI_API_KEY    — fallback when LLM_PROVIDER=gemini
# CLAUDE_API_KEY    — fallback when LLM_PROVIDER=claude
# OPENAI_API_KEY    — fallback when LLM_PROVIDER=openai or openai_compatible
#
# Use only ONE of LLM_API_KEY or the provider-specific key. If both are set, LLM_API_KEY wins.
# GEMINI_API_KEY=
# CLAUDE_API_KEY=
# OPENAI_API_KEY=
#
# ─ LLM Provider Defaults (Reference) ────────────────────────────────────
# The bot auto-selects a sensible default LLM_MODEL and LLM_BASE_URL for each
# provider if you leave them blank. Override either with your own values to use
# a different model or a self-hosted endpoint. Provider-specific keys are matched
# in the table above (see Provider-Specific Alternatives block).
#
# ┌──────────────────┬─────────────────────────────┬─────────────────────────────────┐
# │ LLM_PROVIDER     │ Default LLM_MODEL            │ LLM_BASE_URL needed?            │
# ├──────────────────┼─────────────────────────────┼─────────────────────────────────┤
# │ gemini           │ gemini-1.5-flash             │ NO  (uses Google API directly)  │
# │ claude           │ claude-3-5-haiku-latest      │ NO  (uses Anthropic API)        │
# │ openai           │ gpt-4o-mini                  │ NO  (uses api.openai.com)       │
# │ grok             │ grok-2-latest                │ YES → https://api.x.ai/v1       │
# │ groq             │ llama-3.1-70b-versatile      │ YES → https://api.groq.com/openai/v1│
# │ qwen             │ qwen-plus                    │ YES → https://dashscope.aliyuncs.com/compatible-mode/v1│
# │ ollama           │ llama3.1                     │ YES → http://localhost:11434/v1 │
# │ deepseek         │ deepseek-chat                │ YES → https://api.deepseek.com/v1│
# │ openrouter       │ anthropic/claude-3.5-sonnet  │ YES → https://openrouter.ai/api/v1│
# │ openai_compatible│ gpt-4o-mini                  │ YES → your endpoint URL         │
# └──────────────────┴─────────────────────────────┴─────────────────────────────────┘
#
# Important: only gemini, claude, and openai have a working base URL out-of-the-box.
# For grok/groq/qwen/ollama/deepseek/openrouter/openai_compatible you MUST set
# LLM_BASE_URL or the request will silently go to api.openai.com and fail with 401.
#
# Examples (only needed for YES rows):
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_BASE_URL=http://localhost:11434/v1
#
# Other notes:
#   - For ollama, no API key is required (the bot auto-uses "ollama" as placeholder).
#   - For Gemini, web search uses Google Search grounding (built-in).
#   - For all other providers, web search uses DuckDuckGo (free, no key needed).
#   - Set LLM_MODEL to override the default for any provider.
#
# ─ Playlist Load Limit (Legacy Alias) ───────────────────────────────────
# The bot reads MAX_PLAYLIST_ITEMS above. MAX_PLAYLIST_TRACKS is a legacy alias kept
# for backward compatibility with older configs. Both work, but prefer MAX_PLAYLIST_ITEMS.
# MAX_PLAYLIST_TRACKS=50

# Spotify integration — purpose, behavior, and credentials
#
# PURPOSE:
#   Lets the bot play Spotify track/album/playlist URLs (e.g. https://open.spotify.com/track/...)
#   by resolving Spotify metadata into a playable audio source. Without these, the bot will
#   fall back to YouTube search for any Spotify URLs submitted.
#
# HOW IT WORKS:
#   The bot supports two Spotify authentication modes, picked automatically by get_spotify_token()
#   in src/source.rs:
#
#   Mode A — OFFICIAL (recommended, set both fields below):
#     Uses Spotify's Client Credentials OAuth flow against api.spotify.com. Higher rate limits,
#     stable access, full metadata coverage. Requires a free Spotify Developer app.
#
#   Mode B — ANONYMOUS GUEST (auto-fallback when fields are blank):
#     Falls back to the public Spotify Web Player's anonymous guest token. Works out-of-the-box
#     but rate-limits aggressively on shared IPs / multiple users. Fine for personal testing,
#     unreliable for production / public bots.
#
# SETUP (Mode A — recommended):
#   1. Go to https://developer.spotify.com/dashboard and log in
#   2. Click "Create app", accept terms, fill in name + description (e.g. "Personal Discord bot")
#   3. Copy "Client ID" and "Client secret" from the app's settings page
#   4. Paste them below, then restart the bot
#
# TO DISABLE SPOTIFY ENTIRELY:
#   Leave both fields blank — the bot still loads Spotify URLs (via guest token) but with
#   lower reliability. There is no "off" switch; the bot always tries Spotify when given a
#   Spotify URL. To force YouTube-only playback, users must submit YouTube URLs explicitly.
#
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
