# ─ Discord Bot Credentials (Required) ───────────────────────────────────
# Create a bot at https://discord.com/developers/applications
# Enable: Message Content Intent, Server Members Intent, Voice States
DISCORD_BOT_TOKEN=

# ─ Logging ──────────────────────────────────────────────────────────────
# Levels: ERROR (only errors), WARN, INFO (default), DEBUG (verbose),
#         TRACE (extremely verbose, for development)
LOG_LEVEL=INFO

# ─ External Executables (Custom Paths) ──────────────────────────────────
# Path to ffmpeg/yt-dlp. Defaults to system PATH if left empty.
# Common: ffmpeg, yt-dlp (or full paths like /usr/bin/ffmpeg)
FFMPEG_PATH=ffmpeg
YTDLP_PATH=yt-dlp

# ─ Custom Emojis ────────────────────────────────────────────────────────
# Optional: Use custom server emojis for platform indicators in embeds
# Format: <:name:id> — e.g. <:spotify:123456789012345678>
EMOJI_SPOTIFY=
EMOJI_YOUTUBE=
EMOJI_SOUNDCLOUD=

# ─ Language ─────────────────────────────────────────────────────────────
# Select interface language. All user-facing strings (embeds, buttons,
# error messages, descriptions) are translated.
#   en = English (default)
#   id = Indonesian (Bahasa Indonesia)
BOT_LANG=en

# ─ Now Playing Card Behavior ────────────────────────────────────────────
# Controls how the Now Playing embed updates when the queue advances to
# the next track. Pick whichever feels cleaner for your server.
#
#   old = Keep history (default). Each track posts a brand new card in
#         the channel. Previous cards stay visible — you can scroll up
#         to see what was played. When the queue finishes, a separate
#         "done" message is posted.
#         Example channel timeline:
#           [Now Playing: Track 1] -> [Now Playing: Track 2] -> [Done]
#
#   new = Clean channel. The previous card is deleted before the new
#         one is posted, so only one card is visible at any time. When
#         the queue finishes, the last card is edited in-place to show
#         "Queue finished" — no extra message.
#         Example channel timeline:
#           [Now Playing: Track 1] -> [Now Playing: Track 2] -> (edited: Done)
#
# Unset or empty defaults to "old".
NOW_PLAYING_BEHAVIOR=old
# NOW_PLAYING_BEHAVIOR=new

# ─ Playlist & Radio/Mix Cap ─────────────────────────────────────────────
# Maximum number of tracks to load from YouTube playlists, mixes (list=RD),
# YouTube Radio, or Spotify playlists/albums.
# Setting a limit speeds up loading and prevents queue flooding.
# Default is 50. Set to 0 for unlimited.
MAX_PLAYLIST_ITEMS=50

# ─ MongoDB Database (Personal Playlist Storage) ─────────────────────────
# Store personal user playlists (/playlist save, /playlist load, etc.)
# If left empty, the bot automatically falls back to local file storage (data/playlists.json).
MONGO_USER=usermaybees
MONGO_PASSWORD=
MONGO_HOST=cluster0.ezivhgd.mongodb.net
MONGO_APP_NAME=Cluster0
MONGO_DATABASE=discord_music_bot

# Or provide a complete connection URI directly:
# MONGODB_URI=mongodb+srv://...

# ─ Universal Multi-Provider AI DJ (Gemini, Claude, Grok, Qwen, Ollama, etc.) ──
# Powers natural language mood search (/recommend mood:...), live charismatic DJ
# commentary on server music taste, and song trivia.
# If LLM_API_KEY is left empty, the bot seamlessly uses the local heuristic taste profiler!
#
# Supported providers:
#   - gemini (default, free tier at https://aistudio.google.com)
#   - claude (Anthropic Messages API)
#   - openai (Official OpenAI API)
#   - openai_compatible (for Grok, Qwen, Groq, DeepSeek, Ollama, OpenRouter, etc.)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Enable real-time Web Search Grounding (Google Search for Gemini, DuckDuckGo for Claude/OpenAI/Qwen/etc.)
# Default: true. Set to false to disable web grounding.
LLM_WEB_SEARCH=true

# Optional: Custom endpoint URL (e.g. for Ollama, OpenRouter, Groq, xAI)
# LLM_BASE_URL=https://api.groq.com/openai/v1

SPOTIFY_CLIENT_ID=masukkan_client_id_disini
SPOTIFY_CLIENT_SECRET=masukkan_client_secret_disini
